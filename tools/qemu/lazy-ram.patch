+/*
+ * Guest RAM is committed on first touch (util/oslib-win32.c). A guest access
+ * to a page that is reserved but not committed exits as a memory access on a
+ * mapped GPA, before the instruction executes: commit the chunk and run the
+ * instruction again. A writable RAM mapping has no other reason to exit; the
+ * same page exiting over and over goes to the emulator as before.
+ */
+static bool whpx_commit_guest_ram(WHV_MEMORY_ACCESS_CONTEXT *ctx)
+{
+    static __thread uint64_t last_page = -1;
+    static __thread unsigned int repeats;
+    uint64_t page = ctx->Gpa & qemu_real_host_page_mask();
+    MemoryRegion *mr;
+    hwaddr xlat, len = 1;
+
+    if (ctx->AccessInfo.GpaUnmapped) {
+        return false;
+    }
+    if (page != last_page) {
+        last_page = page;
+        repeats = 0;
+    } else if (++repeats > 8) {
+        return false;
+    }
+
+    RCU_READ_LOCK_GUARD();
+    mr = address_space_translate(&address_space_memory, ctx->Gpa, &xlat, &len,
+                                 false, MEMTXATTRS_UNSPECIFIED);
+    if (!memory_region_is_ram(mr) || mr->readonly || mr->rom_device) {
+        return false;
+    }
+    return qemu_ram_commit(memory_region_get_ram_ptr(mr) + xlat, 1, true);
+}
+
