; PROJECT:     OpenNT network tests
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     Installs the NetAdapterCx simulated link peer test adapter
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif193.001@gmail.com>

[Version]
Signature = "$Windows NT$"
Class = Net
ClassGUID = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider = %OpenNT%
DriverVer = 10/29/2026,1.0.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
netcxloop.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%OpenNT% = OpenNT,NTamd64,NTarm64

[OpenNT.NTamd64]
%NetCxLoop.DeviceDesc% = NetCxLoop_Device, ROOT\NETCXLOOP

[OpenNT.NTarm64]
%NetCxLoop.DeviceDesc% = NetCxLoop_Device, ROOT\NETCXLOOP

[NetCxLoop_Device.NT]
AddReg = NetCxLoop_AddReg
CopyFiles = NetCxLoop_CopyFiles
Characteristics = 0x1
*IfType = 6
*MediaType = 0
*PhysicalMediaType = 14
*IfConnectorPresent = 0
*ConnectionType = 1
*DirectionType = 0
*AccessType = 2
*HardwareLoopback = 0

[NetCxLoop_CopyFiles]
netcxloop.sys

[NetCxLoop_AddReg]
HKR, Ndi, Service, 0, "NetCxLoop"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[NetCxLoop_Device.NT.Services]
AddService = NetCxLoop, 0x00000002, NetCxLoop_Service

[NetCxLoop_Service]
DisplayName = %NetCxLoop.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\netcxloop.sys

[NetCxLoop_Device.NT.Wdf]
KmdfService = NetCxLoop, NetCxLoop_WdfSection

[NetCxLoop_WdfSection]
KmdfLibraryVersion = 1.33

[Strings]
OpenNT = "OpenNT Project"
DiskName = "OpenNT NetAdapterCx test disk"
NetCxLoop.DeviceDesc = "OpenNT NetAdapterCx Test Adapter"
NetCxLoop.ServiceDesc = "OpenNT NetAdapterCx Test Adapter Service"
